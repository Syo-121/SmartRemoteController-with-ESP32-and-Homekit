// このファイルを secrets.h という名前でコピーして値を設定してください
// secrets.h は .gitignore で除外されています（公開しないこと）

// HTTP APIの認証トークン（未設定の場合HTTP APIは起動しません）
// 例）python -c "import secrets;print(secrets.token_urlsafe(24))" で生成
#define SMARTRC_API_TOKEN "change-me"

// HomeKitのペアリングコード（8桁．未設定の場合はHomeSpanの初期値 46637726）
// 使う場合はコメントを外して自分の8桁に変更（12345678やゾロ目はiOSに弾かれる）
// #define SMARTRC_PAIRING_CODE "xxxxxxxx"
